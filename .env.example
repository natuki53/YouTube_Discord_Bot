# Discord Bot Token
# https://discord.com/developers/applications で取得
DISCORD_TOKEN=your_discord_bot_token_here

# Bot Prefix（レガシー用、スラッシュコマンドは BOT_PREFIX 非依存）
BOT_PREFIX=!

# ダウンロード先
DOWNLOAD_DIR=downloads
DOWNLOAD_TMP_DIR=downloads/tmp

# Discord 添付上限（MB）
MAX_FILE_SIZE=25

# 同時ダウンロード数・処理タイムアウト（秒）・一時ファイル保持時間（分）
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=600
TMP_MAX_AGE_MINUTES=30

# MP3 音質（yt-dlp の --audio-quality）
MP3_BITRATE_DEFAULT=192
MP3_BITRATE_LONG=128

# カンマ区切り
SUPPORTED_QUALITIES=144p,240p,360p,480p,720p,1080p

# VC 再生のデフォルト音量（1〜100）
DEFAULT_VOLUME=25
